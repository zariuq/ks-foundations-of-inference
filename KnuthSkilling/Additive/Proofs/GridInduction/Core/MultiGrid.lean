lemma extensionSetC_base_iff_remMulti {k : ℕ} {F : AtomFamily α k} (H : GridComm F) (d : α)
    (r0 r : Multi k) (u : ℕ) :
    r ∈ extensionSetC_base F d r0 u ↔

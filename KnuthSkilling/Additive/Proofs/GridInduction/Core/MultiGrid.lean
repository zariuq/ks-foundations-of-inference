/-- **Helper**: Iterates of atoms are grid members. -/
lemma iterate_atom_mem_kGrid {k : ℕ} (F : AtomFamily α k) (i : Fin k) (n : ℕ) :
    iterate_op (F.atoms i) n ∈ kGrid F := by
  use unitMulti i n
  exact (mu_unitMulti F i n).symm

